<variant
    name="devDebug"
    package="com.catalent.onehub"
    minSdkVersion="32"
    targetSdkVersion="36"
    debuggable="true"
    mergedManifest="build/intermediates/merged_manifest/devDebug/processDevDebugMainManifest/AndroidManifest.xml"
    manifestMergeReport="build/outputs/logs/manifest-merger-dev-debug-report.txt"
    partialResultsDir="build/intermediates/unit_test_lint_partial_results/devDebug/lintAnalyzeDevDebugUnitTest/out">
  <buildFeatures
      namespacing="REQUIRED"/>
  <sourceProviders>
  </sourceProviders>
  <testSourceProviders>
    <sourceProvider
        manifests="src/test/AndroidManifest.xml"
        javaDirectories="src/test/java:src/testDev/java:src/testDebug/java:src/testDevDebug/java:src/test/kotlin:src/testDev/kotlin:src/testDebug/kotlin:src/testDevDebug/kotlin"
        assetsDirectories="src/test/assets:src/testDev/assets:src/testDebug/assets:src/testDevDebug/assets"
        unitTest="true"/>
  </testSourceProviders>
  <testFixturesSourceProviders>
  </testFixturesSourceProviders>
  <resValues>
    <resValue
        type="string"
        name="app_name"
        value="OneHub Dev" />
  </resValues>
  <artifact
      type="UNIT_TEST">
  </artifact>
</variant>
