<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CatalentOneHubNoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="Theme.CatalentOneHub" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/onelogo</item>
        <item name="postSplashScreenTheme">@style/Theme.CatalentOneHubNoActionBar</item>
    </style>
</resources>